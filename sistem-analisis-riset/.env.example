# Kata sandi area peneliti (wajib diganti di produksi)
RESEARCHER_PASSWORD=riset-sambas-2026

# Rahasia penandatanganan cookie sesi (min. 32 karakter)
SESSION_SECRET=ganti-dengan-rahasia-panjang-acak-min-32-karakter

# Basis URL SIPP publik PA Sambas
SIPP_BASE_URL=https://sipp.pa-sambas.go.id

# Jeda antar permintaan SIPP (ms) — etika rate limiting
SIPP_MIN_INTERVAL_MS=1500

# User-Agent yang jelas untuk fetch publik
SIPP_USER_AGENT=YS-Research-Dashboard/1.0 (+thesis PA Sambas; polite public fetch)

# Path SQLite (relatif ke folder aplikasi)
DATABASE_PATH=./data/research.db
